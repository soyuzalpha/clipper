# Database — absolute path recommended for production (Ubuntu server).
# Local dev: file:./data/content.db works if CWD is the project root.
DATABASE_URL="file:/var/lib/clipper/content.db"

# Auth — REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
AUTH_TRUST_HOST="true"

# Admin user created by `pnpm db:seed`.
# Change ADMIN_PASSWORD before seeding in production.
ADMIN_EMAIL="admin@clipper.os"
ADMIN_PASSWORD="CHANGE_ME"

# AI gateway (optional — mock provider works without keys)
# AI_PROVIDER="mock"        # "mock" (no keys) or "hemattoken" (real AI)
# HematToken is the AI gateway/router. Never connect to vendor APIs directly.
# AI_PROVIDER="hemattoken"
# AI_GATEWAY_BASE_URL="https://api.hemattoken.id/v1"
# AI_GATEWAY_API_KEY=""      # server-side only — never exposed to the client
# AI_GATEWAY_MODEL=""        # e.g. "provider/model" or a HematToken combo name

# Content storage — where uploaded/imported library files live on disk.
# Defaults to ./storage in the project root when unset. Production should point
# at the server data dir, e.g. /var/lib/clipper/storage.
CONTENT_STORAGE_PATH="./storage"
# CONTENT_MAX_UPLOAD_MB="512"   # per-file upload cap, default 512 MB
